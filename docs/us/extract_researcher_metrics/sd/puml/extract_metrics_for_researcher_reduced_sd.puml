@startuml

autonumber

actor Admin as user

participant UI as ui

participant "Extraction\nController" as controller

participant "Pipeline\nService" as pipeline_service
participant "Extraction\nService" as extraction_service
participant "Normalization\nService" as normalization_service
participant "ResearcherMetric\nService" as metric_service
participant "ExtractionRun\nService" as extraction_run_service

participant "Postgres\nUser" as user_repo
participant "Postgres\nResearcherProfile" as profile_repo
participant "Postgres\nResearcherMetric" as metric_repo
participant "Postgres\nExtractionRun" as extraction_run_repo

participant Extractor as extractor

participant Repositories as repos

activate user
    user -> ui: request metric extraction for user
    activate ui
        ui -> controller: GET: /extraction/run/{id}

        activate controller
            controller -> pipeline_service: run_for_user(user_id)

            activate pipeline_service
                pipeline_service -> extraction_service: extract_for_user(user_id)

                activate extraction_service
                    extraction_service -> repos: _aenter_()

                    activate repos
                        repos --> extraction_service
                        extraction_service -> user_repo: get_by_id(user_id)

                        activate user_repo
                            user_repo --> extraction_service: User
                        deactivate user_repo

                            extraction_service -> profile_repo: get_by_id(user.profile.id)

                        activate profile_repo
                            profile_repo --> extraction_service: ResearcherProfile
                        deactivate profile_repo

                        extraction_service -> extractor: extract(query)
                        activate extractor
                            extractor --> extraction_service: RawScholarMetrics
                        deactivate extractor

                        extraction_service -> extractor: extract(query)
                        activate extractor
                            extractor --> extraction_service: RawWosMetrics
                        deactivate extractor

                        extraction_service -> extractor: extract(user.name, profile.keywords)
                        activate extractor
                            extractor --> extraction_service: RawScopusMetrics
                        deactivate extractor

                        extraction_service -> extractor: extract_by_id(orcid)
                        activate extractor
                            extractor --> extraction_service: RawOrcidProfile
                        deactivate extractor

                        extraction_service --> pipeline_service: RawExtractionResult
                    deactivate extraction_service

                    pipeline_service -> normalization_service: normalize(raw)

                    activate normalization_service
                        normalization_service -> profile_repo: get_by_user_id(raw.user_id)

                        activate profile_repo
                            profile_repo --> normalization_service: ResearcherProfile
                        deactivate profile_repo

                        normalization_service --> pipeline_service: NormalizationResult
                    deactivate normalization_service

                    pipeline_service -> extraction_run_service: create_run(normalize.run)

                    activate extraction_run_service
                        extraction_run_service -> extraction_run_repo: save(run)

                        activate extraction_run_repo
                            extraction_run_repo --> extraction_run_service

                        deactivate extraction_run_repo

                        extraction_run_service --> pipeline_service
                    deactivate extraction_run_service

                    pipeline_service -> pipeline_service: persist normalized metric
                    pipeline_service -> repos: _aexit_()

                    repos --> pipeline_service
                deactivate repos

                pipeline_service --> controller: ExtractionPipelineResult
            deactivate pipeline_service

            controller --> ui: HTTP 200 OK
        deactivate controller

        ui --> user: success message
    deactivate ui
deactivate user
@enduml