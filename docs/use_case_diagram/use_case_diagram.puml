@startuml
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

actor "Administrator" as Admin
actor "Researcher" as Researcher

rectangle "System" {

    package "User & Profile Management" {
        usecase "UC01\nManage users" as UC01
        usecase "UC02\nManage researcher profiles" as UC02
        usecase "UC03\nManage researcher metrics" as UC03
    }

    package "Metric Extraction" {
        usecase "UC04\nExtract researcher metrics" as UC04
        usecase "UC05\nScheduled extraction" as UC05
    }

    package "Dashboards" {
        usecase "UC06\nView individual dashboard" as UC06
        usecase "UC07\nView organization dashboard" as UC07
    }

    package "Data Export" {
        usecase "UC08\nExport own metrics" as UC08
        usecase "UC09\nExport specific researcher" as UC09
        usecase "UC10\nExport all researchers" as UC10
    }
}

Admin -- UC01
Admin -- UC02
Admin -- UC03
Admin -- UC04
Admin -- UC05
Admin -- UC06
Admin -- UC07
Admin -- UC09
Admin -- UC10

Researcher -- UC06
Researcher -- UC08

@enduml
